\language "english"         %English note names like "eb" and "ds"
\include "articulate.ly"    %more musical MIDI output

\paper {
  #(set-paper-size "letter")
  two-sided = ##t
  inner-margin = 0.75\in
  outer-margin = 0.5\in
  top-margin = 0.5\in
  bottom-margin = 0.5\in
  indent = 0
  print-all-headers = ##t
  ragged-bottom = ##t
}
